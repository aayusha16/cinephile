
<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950 px-4 py-12">

  <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl p-8">

    <div class="text-center mb-8">
      <h1 class="text-4xl font-extrabold text-indigo-700 tracking-tight">
        CINEPHILE
      </h1>

      <p class="text-gray-500 mt-2">
        Your next favourite movie starts here.
      </p>

      <h2 class="text-2xl font-bold text-gray-800 mt-7">
        Create an Account
      </h2>

      <p class="text-gray-500 text-sm mt-1">
        Join our community of movie lovers.
      </p>
    </div>

    <% if @user.errors.any? %>
      <div class="mb-5 rounded-lg bg-red-50 border border-red-200 p-4 text-red-700 text-sm">
        <% @user.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @user do |form| %>

      <div class="mb-5">
        <%= form.label :name, "Full Name", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_field :name,
            required: true,
            autocomplete: "name",
            placeholder: "Enter your full name",
            class: "w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div class="mb-5">
        <%= form.label :email, "Email Address", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.email_field :email,
            required: true,
            autocomplete: "email",
            placeholder: "you@example.com",
            class: "w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div class="mb-5">
        <%= form.label :password, "Password", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.password_field :password,
            required: true,
            autocomplete: "new-password",
            placeholder: "Create a password",
            class: "w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div class="mb-7">
        <%= form.label :password_confirmation, "Confirm Password", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.password_field :password_confirmation,
            required: true,
            autocomplete: "new-password",
            placeholder: "Enter your password again",
            class: "w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div style="margin-top: 24px;">
  <button type="submit"
    style="width: 100%; padding: 14px; background-color: #4f46e5; color: white; border: none; border-radius: 10px; font-size: 16px; font-weight: bold; cursor: pointer;">
    Create Account
  </button>
</div>

    <% end %>

    <p class="text-center text-sm text-gray-500 mt-7">
  Already have an account?
  <a href="/session/new"
     style="color: #4f46e5; font-weight: bold; text-decoration: underline;">
    Login
  </a>
</p>

  </div>
</div>
