
<div class="min-h-screen bg-[#0b0b0f] px-8 py-12 text-white">

  <div class="mx-auto max-w-7xl">

    <%= link_to "← Back to Home", root_path,
        class: "text-amber-400 transition hover:text-amber-300" %>

    <h1 class="mb-2 mt-8 text-3xl font-bold text-amber-400">
      Search Results
    </h1>

    <p class="mb-8 text-gray-400">
      Found <%= @movies.count %> matching movies.
    </p>

    <% if @movies.any? %>

      <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">

        <% @movies.each do |movie| %>

          <%= link_to movie_path(movie),
              class: "block overflow-hidden rounded-xl border border-white/10 bg-[#111118] transition duration-300 hover:-translate-y-2 hover:border-amber-400/50" do %>

            <% if movie.poster_path.present? %>
              <img
                src="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>"
                alt="<%= movie.title %>"
                class="h-64 w-full object-cover">
            <% else %>
              <div class="flex h-64 items-center justify-center text-gray-500">
                No Poster
              </div>
            <% end %>

            <div class="p-4">

              <h2 class="truncate font-semibold text-white">
                <%= movie.title %>
              </h2>

              <p class="mt-2 text-sm text-gray-400">
                <%= movie.release_date&.year || "Release date unknown" %>
              </p>

              <p class="mt-2 text-sm text-amber-400">
                ★ <%= movie.vote_average&.round(1) || "N/A" %>/10
              </p>

            </div>

          <% end %>

        <% end %>

      </div>

    <% else %>

      <div class="py-20 text-center">
        <h2 class="text-2xl font-semibold text-gray-300">
          No movies found.
        </h2>

        <p class="mt-3 text-gray-500">
          Try searching with another movie name.
        </p>
      </div>

    <% end %>

  </div>

</div>
