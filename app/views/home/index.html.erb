
<div class="min-h-screen bg-[#0b0b0f] text-white">

  <!-- Hero and Search Section -->
  <section class="px-8 py-16 text-center md:px-16">

    <p class="mx-auto max-w-3xl text-lg leading-8 text-gray-400">
      Here's to the film lovers, the dreamers, and everyone who finds a little magic in every story.
    </p>

    <%= form_with url: movies_search_path, method: :get, class: "mx-auto mt-10 flex max-w-2xl gap-3" do |form| %>

      <%= form.text_field :query,
          placeholder: "Search for your favorite movie...",
          class: "flex-1 rounded-lg border border-white/10 bg-[#111118] px-5 py-4 text-white outline-none focus:border-amber-400" %>

      <%= form.submit "Search",
          class: "rounded-lg bg-amber-500 px-8 py-4 font-semibold text-black transition hover:bg-amber-400" %>

    <% end %>

  </section>

  <!-- Popular Movies Section -->
  <section class="px-8 pb-16 md:px-16">

    <div class="mb-8 flex items-center justify-between">
      <div>
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-amber-400">
          TMDB Trending
        </p>

        <h2 class="text-3xl font-bold text-white">
          Popular Movies
        </h2>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">

      <% @movies.each do |movie| %>

        <%= link_to movie_path(movie), class: "block overflow-hidden rounded-xl border border-white/10 bg-[#111118] transition duration-300 hover:-translate-y-2 hover:border-amber-400/50" do %>

          <% if movie.poster_path.present? %>
            <img
              src="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>"
              alt="<%= movie.title %>"
              class="h-64 w-full object-cover">
          <% else %>
            <div class="flex h-64 items-center justify-center text-gray-500">
              No Poster
            </div>
          <% end %>

          <div class="p-4">

            <h3 class="truncate font-semibold text-white">
              <%= movie.title %>
            </h3>

            <p class="mt-2 text-sm text-gray-400">
              <%= movie.release_date&.year || "Release date unknown" %>
            </p>

            <p class="mt-2 text-sm text-amber-400">
              ★ <%= movie.vote_average&.round(1) || "N/A" %>/10
            </p>

          </div>

        <% end %>

      <% end %>

    </div>

  </section>

  <!-- Latest Reviews Section -->
  <section class="mx-auto max-w-7xl px-8 pb-16">

    <h2 class="mb-8 text-3xl font-bold text-amber-400">
      Latest Reviews
    </h2>

    <% if @recent_reviews.any? %>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">

        <% @recent_reviews.each do |review| %>

          <div class="rounded-xl border border-white/10 bg-[#111118] p-6">

            <div class="flex items-center justify-between gap-3">

              <h3 class="font-semibold text-white">
                <%= review.user.name %>
              </h3>

              <span class="text-sm text-gray-500">
                <%= review.created_at.strftime("%b %d, %Y") %>
              </span>

            </div>

            <p class="mt-4 leading-7 text-gray-300">
              <%= review.content %>
            </p>

            <div class="mt-5 border-t border-white/10 pt-4">

              <%= link_to review.movie.title,
                  movie_path(review.movie),
                  class: "font-semibold text-amber-400 transition hover:text-amber-300" %>

            </div>

          </div>

        <% end %>

      </div>

    <% else %>

      <p class="text-gray-400">
        No reviews yet. Be the first to share your thoughts!
      </p>

    <% end %>

  </section>

</div>
